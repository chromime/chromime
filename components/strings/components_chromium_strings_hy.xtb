<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="130631256467250065">Ձեր փոփոխություններն ուժի մեջ կմտնեն հաջորդ անգամ, երբ վերագործարկեք սարքը:</translation>
<translation id="1965068424387304464">Rhendium-ի հետ աշխատելու խորհուրդ․ պահեք գաղտնաբառերը</translation>
<translation id="261308610302996111">Բացեք
          Rhendium-ի ընտրացանկը &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          և համոզվեք, որ ձեր կազմաձևի համար սահմանված է «առանց պրոքսի սերվերի» կամ «ուղիղ» պարամետրը։</translation>
<translation id="275588974610408078">Խափանումների մասին հաղորդումը մատչելի չէ Rhendium-ում:</translation>
<translation id="3064346599913645280">Ցուցադրվող Rhendium էջն անվտանգ է</translation>
<translation id="3255926992597692024">Rhendium-ը փորձում է փոխել վճարման եղանակների լրացման կարգավորումները։</translation>
<translation id="358997566136285270">Rhendium-ի պատկերանշանը</translation>
<translation id="3837584850181228767">Rhendium-ի հետ աշխատելու խորհուրդ․ օգտագործեք բարելավված Ապահով դիտարկումը</translation>
<translation id="4050599136622776556">Rhendium-ը փորձում է փոփոխել վճարման եղանակները։</translation>
<translation id="4365115785552740256">Rhendium-ը ստեղծվել է շնորհիվ <ph name="BEGIN_LINK_CHROMIUM" />Rhendium<ph name="END_LINK_CHROMIUM" /> բաց կոդով նախագծի և այլ <ph name="BEGIN_LINK_OSS" />բաց կոդով ծրագրակազմերի<ph name="END_LINK_OSS" />:</translation>
<translation id="4622039161600275920">Այս էջն արգելափակվել է Rhendium-ի կողմից</translation>
<translation id="48558539577516920">Հրապատի կամ հակավիրուսային ծրագրի կարգավորումներում
       թույլատրեք Rhendium-ին միանալ ցանցին:</translation>
<translation id="4949828774841497663">Գնացեք Հավելվածներ &gt; Համակարգի կարգավորումներ &gt; Ցանց, ընտրեք
         ակտիվ ցանցը, սեղմեք Մանրամասներ... կոճակը և չեղարկեք ցանկացած                              պրոքսի սերվերի ընտրությունը։</translation>
<translation id="6480456350195404966">Բացեք
          Rhendium-ի ընտրացանկը &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Ցանց և ինտերնետ &gt; Պրոքսի սերվեր
          և անջատեք «Ավտոմատ որոշել կարգավորումները» պարամետրը։</translation>
<translation id="648062525172759633">Այս էջերը, որոնք նախատեսված են Rhendium-ի մշակողների համար, չեն կարող պարբերաբար փորձարկվել կամ մշակվել։ Միացնելու համար անցեք <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> էջ, սեղմեք կոճակը՝ վրիպազերծման էջերը միացնելու համար, այնուհետև վերադարձեք այստեղ։</translation>
<translation id="6549378540556750549">Rhendium-ը նաև աշխատում է այլ <ph name="BEGIN_LINK_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_OSS" /> շնորհիվ։</translation>
<translation id="6613594504749178791">Փոփոխություններն ուժի մեջ կմտնեն Rhendium-ը հաջորդ անգամ գործարկելիս:</translation>
<translation id="691026815377248078">Զուգակցումը շարունակելու համար Rhendium-ին հասանելի դարձրեք Bluetooth-ը։ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Rhendium-ը ստեղծվել է <ph name="BEGIN_LINK_CHROMIUM" />Rhendium<ph name="END_LINK_CHROMIUM" />-ի բաց կոդով նախագծի հիման վրա։</translation>
<translation id="7861509383340276692">Անցեք
          Rhendium ընտրացանկ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          և ապանշեք «<ph name="NO_PREFETCH_DESCRIPTION" />»-ը:
          Եթե խնդիրը չվերանա, խորհուրդ ենք տալիս կրկին ընտրել այս տարբերակը՝
          արդյունավետությունը բարձրացնելու համար:</translation>
<translation id="8597726643333341451">Դուք դիտում եք Chrome for Testing-ի անվտանգ էջ</translation>
<translation id="8684913864886094367">Rhendium-ը ճիշտ չի փակվել:</translation>
<translation id="9183331186620388872">Խորհուրդ Rhendium-ից․ որոնեք Տեսապակու միջոցով</translation>
</translationbundle>