<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="130631256467250065">השינויים ייכנסו לתוקף בפעם הבאה שהמכשיר יופעל מחדש.</translation>
<translation id="1965068424387304464">‏טיפ ל-Rhendium: שמירת סיסמאות</translation>
<translation id="261308610302996111">‏צריך להיכנס אל
          תפריט Rhendium‏ &gt;
          <ph name="SETTINGS_TITLE" />
          ‏&gt;
          <ph name="SYSTEM_TITLE" />
          ‏&gt;
          <ph name="PROXIES_TITLE" />
          ולבדוק שהתצורה מוגדרת לאפשרות no proxy (ללא שרת proxy‏) או direct (ישיר).</translation>
<translation id="275588974610408078">‏דיווח על התרסקויות אינו זמין ב-Rhendium.</translation>
<translation id="3064346599913645280">‏זהו דף מאובטח של Rhendium</translation>
<translation id="3255926992597692024">‏Rhendium מנסה לשנות את ההגדרות למילוי אמצעי התשלום.</translation>
<translation id="358997566136285270">‏לוגו של Rhendium</translation>
<translation id="3837584850181228767">‏טיפ ל-Rhendium: הגרסה המשופרת של הגלישה הבטוחה</translation>
<translation id="4050599136622776556">‏Rhendium מנסה לערוך את אמצעי התשלום.</translation>
<translation id="4365115785552740256">‏Rhendium קיים הודות לפרויקט הקוד הפתוח של <ph name="BEGIN_LINK_CHROMIUM" /> Rhendium‏<ph name="END_LINK_CHROMIUM" /> ו<ph name="BEGIN_LINK_OSS" />תוכנות קוד פתוח<ph name="END_LINK_OSS" /> אחרות.</translation>
<translation id="4622039161600275920">‏הדף הזה נחסם על ידי Rhendium</translation>
<translation id="48558539577516920">‏שינוי הגדרות חומת האש או האנטי-וירוס כדי לאפשר ל-Rhendium
          לגשת לרשת.</translation>
<translation id="4949828774841497663">‏עוברים אל "אפליקציות" &gt; "הגדרות המערכת" &gt; "רשת", ובוחרים את
          הרשת הפעילה, לוחצים על הכפתור "פרטים…" ומבטלים את הבחירה בכל שרתי ה-proxy
          שנבחרו.</translation>
<translation id="6480456350195404966">‏צריך להיכנס אל
          תפריט Rhendium‏ &gt;
          <ph name="SETTINGS_TITLE" />
          ‏&gt;
          <ph name="SYSTEM_TITLE" />
          ‏&gt;
          <ph name="PROXIES_TITLE" />
          ‏&gt;
          Network &amp; internet (רשת ואינטרנט) &gt; Proxy (שרת proxy)
          ולבטל את הבחירה באפשרות Automatically detect settings (זיהוי אוטומטי של ההגדרות).</translation>
<translation id="648062525172759633">‏הדפים האלה מיועדים למפתחי Rhendium. יכול להיות שהם לא מתוחזקים או נבדקים באופן פעיל. כדי להפעיל אותם, עוברים לכתובת <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, לוחצים על הכפתור כדי להפעיל את מצב ניפוי הבאגים בדפים, ואז מנווטים בחזרה לדף הזה.</translation>
<translation id="6549378540556750549">‏Rhendium קיים גם הודות ל<ph name="BEGIN_LINK_OSS" />תוכנת קוד פתוח<ph name="END_LINK_OSS" /> אחרת.</translation>
<translation id="6613594504749178791">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את Rhendium‏.</translation>
<translation id="691026815377248078">‏ל-Rhendium נדרשת גישה ל-Bluetooth כדי להמשיך
 את ההתאמה. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">‏Rhendium קיים הודות לפרויקט הקוד הפתוח של <ph name="BEGIN_LINK_CHROMIUM" />Rhendium<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="7861509383340276692">‏יש להיכנס אל
        תפריט Rhendium &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        ולבטל את הבחירה באפשרות '<ph name="NO_PREFETCH_DESCRIPTION" />'.
        אם פעולה זו אינה פותרת את הבעיה, מומלץ לבחור שוב באפשרות זו
        לקבלת ביצועים משופרים.</translation>
<translation id="8597726643333341451">‏זהו דף מאובטח של Chrome for Testing</translation>
<translation id="8684913864886094367">‏כיבוי Rhendium לא בוצע כהלכה.</translation>
<translation id="9183331186620388872">‏טיפ ל-Rhendium: חיפוש באמצעות Lens</translation>
</translationbundle>