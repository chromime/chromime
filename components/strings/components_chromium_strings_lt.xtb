<!DOCTYPE translationbundle>
<translationbundle lang="lt">
<translation id="130631256467250065">Pakeitimai įsigalios kitą kartą iš naujo paleidus įrenginį.</translation>
<translation id="1965068424387304464">„Rhendium“ patarimas: išsaugokite slaptažodžius</translation>
<translation id="261308610302996111">Eikite į
          „Rhendium“ meniu &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          ir įsitikinkite, kad konfigūracija nustatyta kaip „be tarpinio serverio“ arba „tiesioginė“.</translation>
<translation id="275588974610408078">„Rhendium“ negalima teikti strigčių ataskaitų.</translation>
<translation id="3064346599913645280">Peržiūrite saugų „Rhendium“ puslapį</translation>
<translation id="3255926992597692024">„Rhendium“ bando keisti mokėjimo metodų pildymo nustatymus.</translation>
<translation id="358997566136285270">„Rhendium“ logotipas</translation>
<translation id="3837584850181228767">„Rhendium“ patarimas: Sustiprintas saugus naršymas</translation>
<translation id="4050599136622776556">„Rhendium“ bando redaguoti mokėjimo metodus.</translation>
<translation id="4365115785552740256">„Rhendium“ pasiekiama naudojant <ph name="BEGIN_LINK_CHROMIUM" />„Rhendium“<ph name="END_LINK_CHROMIUM" /> atvirojo šaltinio projektą ir kitą <ph name="BEGIN_LINK_OSS" />atvirojo šaltinio programinę įrangą<ph name="END_LINK_OSS" />.</translation>
<translation id="4622039161600275920">Šį puslapį užblokavo „Rhendium“</translation>
<translation id="48558539577516920">Leiskite „Rhendium“ pasiekti tinklą užkardos arba antivirusinės programos
          nustatymuose.</translation>
<translation id="4949828774841497663">Eikite į skiltį „Programos“ &gt; „Sistemos nustatymai“ &gt; „Tinklas“, pasirinkite
          aktyvų tinklą, spustelėkite mygtuką „Išsami informacija...“ ir panaikinkite visų tarpinių serverių,
          kurie galėjo būti pasirinkti, pasirinkimą.</translation>
<translation id="6480456350195404966">Eikite į
          „Rhendium“ meniu &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          „Tinklas ir internetas“ &gt; „Tarpinis serveris“
          ir panaikinkite parinkties „Automatiškai aptikti nustatymus“ pasirinkimą.</translation>
<translation id="648062525172759633">Šie puslapiai skirti naudoti „Rhendium“ kūrėjams ir gali nebūti aktyviai tvarkomi ar išbandomi. Jei norite juos įgalinti, eikite adresu <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, spustelėkite mygtuką, kad įgalintumėte derinimo puslapius, ir tada grįžkite į šį puslapį.</translation>
<translation id="6549378540556750549">„Rhendium“ taip pat pasiekiama naudojant kitą <ph name="BEGIN_LINK_OSS" />atvirojo šaltinio programinę įrangą<ph name="END_LINK_OSS" />.</translation>
<translation id="6613594504749178791">Pakeitimai įsigalios kitą kartą iš naujo paleidus „Rhendium“.</translation>
<translation id="691026815377248078">„Rhendium“ reikia pasiekti „Bluetooth“, kad galėtų sieti
 toliau. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">„Rhendium“ pasiekiama naudojant <ph name="BEGIN_LINK_CHROMIUM" />„Rhendium“<ph name="END_LINK_CHROMIUM" /> atvirojo šaltinio projektą.</translation>
<translation id="7861509383340276692">Eikite į
        „Rhendium“ meniu &gt;
        „<ph name="SETTINGS_TITLE" />“
        &gt;
        „<ph name="ADVANCED_TITLE" />“
        ir panaikinkite „<ph name="NO_PREFETCH_DESCRIPTION" />“ pasirinkimą.
        Jei tai atlikus problema išlieka, rekomenduojame vėl pasirinkti šią parinktį,
        kad pagerėtų našumas.</translation>
<translation id="8597726643333341451">Peržiūrite saugų „Chrome for Testing“ puslapį</translation>
<translation id="8684913864886094367">„Rhendium“ netinkamai išsijungė.</translation>
<translation id="9183331186620388872">„Rhendium“ patarimas: ieškokite naudodami „Lens“</translation>
</translationbundle>