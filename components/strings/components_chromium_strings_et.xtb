<!DOCTYPE translationbundle>
<translationbundle lang="et">
<translation id="130631256467250065">Muudatused jõustuvad järgmine kord, kui seadme taaskäivitate.</translation>
<translation id="1965068424387304464">Rhendiumi nõuanne: salvestage paroolid</translation>
<translation id="261308610302996111">Minge
          Rhendiumi menüüsse &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          ja veenduge, et konfiguratsioon on määratud valikule „Puhverserverita” või „Otse”.</translation>
<translation id="275588974610408078">Krahhiaruandlus ei ole Rhendiumis saadaval.</translation>
<translation id="3064346599913645280">Vaatate turvalist Rhendiumi lehte</translation>
<translation id="3255926992597692024">Rhendium proovib muuta makseviiside sisestamise seadeid.</translation>
<translation id="358997566136285270">Rhendiumi logo</translation>
<translation id="3837584850181228767">Rhendiumi nõuanne: täiustatud ohutu sirvimine</translation>
<translation id="4050599136622776556">Rhendium üritab muuta makseviise.</translation>
<translation id="4365115785552740256">Rhendiumi aluseks on avatud lähtekoodiga projekt <ph name="BEGIN_LINK_CHROMIUM" />Rhendium<ph name="END_LINK_CHROMIUM" /> ja muu <ph name="BEGIN_LINK_OSS" />avatud lähtekoodiga tarkvara<ph name="END_LINK_OSS" />.</translation>
<translation id="4622039161600275920">Rhendium blokeeris selle lehe</translation>
<translation id="48558539577516920">Lubage Rhendiumi juurdepääs võrgule tulemüüri või viirusetõrje
         seadetes.</translation>
<translation id="4949828774841497663">Avage Applications &gt; System Settings &gt; Network, valige
          aktiivne võrk, klõpsake nupul Details... ja tühistage mis tahes puhverserverite valikud,
          mis võisid olla valitud.</translation>
<translation id="6480456350195404966">Avage
          Rhendiumi menüü &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Võrk ja internet &gt; Puhverserver
          ning tühistage valik „Tuvasta seaded automaatselt“.</translation>
<translation id="648062525172759633">Need lehed on mõeldud kasutamiseks Rhendiumi arendajatele ning neid ei pruugita aktiivselt hooldada ega testida. Silumislehtede lubamiseks navigeerige lingile <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, klõpsake selleks ettenähtud nupul ja seejärel navigeerige uuesti praegusele lehele.</translation>
<translation id="6549378540556750549">Rhendiumi võimaldab pakkuda ka muu <ph name="BEGIN_LINK_OSS" />avatud lähtekoodiga tarkvara<ph name="END_LINK_OSS" />.</translation>
<translation id="6613594504749178791">Teie muudatused jõustuvad järgmine kord, kui Rhendiumi taaskäivitate.</translation>
<translation id="691026815377248078">Rhendium vajab sidumise jätkamiseks juurdepääsu Bluetoothile. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Rhendiumi võimaldab pakkuda <ph name="BEGIN_LINK_CHROMIUM" />Rhendiumi<ph name="END_LINK_CHROMIUM" /> avatud lähtekoodi projekt.</translation>
<translation id="7861509383340276692">Avage
        Rhendiumi menüü &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        ja tühistage valik „<ph name="NO_PREFETCH_DESCRIPTION" />”.
        Kui see probleemi ei lahenda, soovitame selle valiku
        toimivuse parandamiseks uuesti teha.</translation>
<translation id="8597726643333341451">Vaatate turvalist brauseri Chrome for Testing lehte</translation>
<translation id="8684913864886094367">Rhendium ei sulgunud õigesti.</translation>
<translation id="9183331186620388872">Rhendiumi nõuanne: otsige Lensiga</translation>
</translationbundle>