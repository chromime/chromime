<!DOCTYPE translationbundle>
<translationbundle lang="bs">
<translation id="130631256467250065">Vaše promjene će stupiti na snagu kada sljedeći put ponovo pokrenete uređaj.</translation>
<translation id="1965068424387304464">Savjet za Rhendium: sačuvajte lozinke</translation>
<translation id="261308610302996111">Idite u
          meni Rhendiuma&gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          i provjerite je li vaša konfiguracija postavljena na "bez proksi servera" ili "direktno".</translation>
<translation id="275588974610408078">Izrada izvještaja o padovima aplikacije nije dostupna na Rhendiumu.</translation>
<translation id="3064346599913645280">Prikazana vam je sigurna stranica Rhendiuma</translation>
<translation id="3255926992597692024">Rhendium pokušava izmijeniti postavke za popunjavanje načina plaćanja.</translation>
<translation id="358997566136285270">Logotip Rhendiuma</translation>
<translation id="3837584850181228767">Savjet za Rhendium: poboljšano Sigurno pregledanje</translation>
<translation id="4050599136622776556">Rhendium pokušava urediti načine plaćanja.</translation>
<translation id="4365115785552740256">Rhendium je dostupan zahvaljujući <ph name="BEGIN_LINK_CHROMIUM" />Rhendium<ph name="END_LINK_CHROMIUM" /> projektu otvorenog koda i drugom <ph name="BEGIN_LINK_OSS" />softveru otvorenog koda<ph name="END_LINK_OSS" />.</translation>
<translation id="4622039161600275920">Ovu stranicu je blokirao Rhendium</translation>
<translation id="48558539577516920">U postavkama zaštitnog zida ili antivirusnog programa dozvolite Rhendiumu da pristupi
          mreži.</translation>
<translation id="4949828774841497663">Idite u Aplikacije &gt; Postavke sistema &gt; Mreža, odaberite
          aktivnu mrežu, kliknite na dugme Detalji… i poništite odabir svih proksi servera
          koji su možda odabrani.</translation>
<translation id="6480456350195404966">Idite u
          meni Rhendiuma &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Mreža i internet &gt; Proksi server
          i poništite odabir opcije "Automatski otkrivaj postavke".</translation>
<translation id="648062525172759633">Ove stranice su namijenjene za korištenje programerima Rhendiuma i možda se neće aktivno održavati ili testirati. Da ih omogućite, idite na <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, kliknite na dugme da omogućite stranice za otklanjanje grešaka, zatim se vratite na ovu stranicu.</translation>
<translation id="6549378540556750549">Rhendium su omogućili i drugi <ph name="BEGIN_LINK_OSS" />softveri otvorenog koda<ph name="END_LINK_OSS" />.</translation>
<translation id="6613594504749178791">Vaše promjene će stupiti na snagu kada sljedeći put budete ponovo pokrenuli Rhendium.</translation>
<translation id="691026815377248078">Rhendiumu je potreban pristup Bluetoothu da nastavi s
uparivanjem. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Rhendium je omogućio <ph name="BEGIN_LINK_CHROMIUM" />Rhendium<ph name="END_LINK_CHROMIUM" /> projekat otvorenog koda.</translation>
<translation id="7861509383340276692">Idite na
          meni u Rhendiumu &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          i poništite odabir za "<ph name="NO_PREFETCH_DESCRIPTION" />."
          Ako ovo ne riješi problem, preporučujemo vam da ponovo odaberete
          ovu opcija za unapređenje performansi.</translation>
<translation id="8597726643333341451">Gledate sigurnu stranicu verzije Chrome for Testing</translation>
<translation id="8684913864886094367">Rhendium se nije ispravno zatvorio.</translation>
<translation id="9183331186620388872">Savjet za Rhendium: pretražujte putem Objektiva</translation>
</translationbundle>