import("//testing/test.gni")

source_set("chromime_fonts") {
  sources = [
    "chromime_font_manager.cc",
    "chromime_font_manager.h",
  ]

  deps = [
    "//base",
    "//crypto",
    "//skia",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "chromime_font_manager_unittest.cc" ]
  deps = [
    ":chromime_fonts",
    "//base",
    "//base/test:test_support",
    "//crypto",
    "//skia",
    "//testing/gtest",
  ]
  data_deps = [ "//third_party/test_fonts" ]
}

test("chromime_font_manager_unittests") {
  deps = [
    ":unit_tests",
    "//testing/gtest:gtest_main",
  ]
}
