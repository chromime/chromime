<translation id="6309712487085796862">I-Rhendium isebenzisa ikhamela yakho.</translation>
<translation id="6333502561965082103">Okunye ukusebenza ku-Rhendium kuyaqhubeka. Sicela uzame futhi emuva kwesikhathi.</translation>
<translation id="6334986366598267305">Manje kulula ukusebenzisa i-Rhendium nge-Akhawunti yakho ye-Google nakumakhompyutha abiwe.</translation>
<translation id="6347002662287820329">Thola ukufinyelela okulula ezakhini ozaziyo, ozithandayo, futhi ozethembayo ngokusetha iRhendium njengebhrawuza yakho evuleka ngokuzenzakalelayo.</translation>
<translation id="6347933965114150440">Isinqamuleli se-Rhendium</translation>
<translation id="6366160072964553914">I-Rhendium ivimbele lokhu kudawunilodwa ngoba ifayela alivamile ukudawunilodwa futhi lingase libe yingozi</translation>
<translation id="6373523479360886564">Ingabe uqinisekile ukuthi ufuna ukukhipha i-Rhendium?</translation>
<translation id="6375219077595103062">Engeza isinqamuleli Kusiphathi Sephasiwedi</translation>
<translation id="6388799252195623474">ngisize ngalokhu</translation>
<translation id="6390800440335263989">Ukuze uqhubeke, ngena ngemvume kuRhendium njengo-<ph name="EMAIL" />. Lokhu kuqinisekisa ukuthi unezinqubomgomo zenhlangano yakho.</translation>
<translation id="6400112897226594999">Ilogo ye-Rhendium ngaphakathi kwesikrini sekhompyutha.</translation>
<translation id="6403826409255603130">I-Rhendium yisiphequluli sewebhu esiqalisa amakhasi wewebhu nezinhlelo zokusebenza ngesivinini sombani. Iyashesha, izinzile, futhi isebenziseka kalula. Dlulisa amehlo kuwebhu ngokuvikeleke kakhulu ngokuvikelwa kuhlelo olungayilungele ikhompyutha nobugebengu bokweba imininingwane ebucayi eyakhelwe ku-Rhendium.</translation>
<translation id="6414624068245092115">Ukuze uqinisekise ukuthi ungakwazi njalo ukusebenzisa futhi ulondoloze idatha yeRhendium kuGoogle Account yakho, qinisekisa ukuthi nguwe</translation>
<translation id="642132557830635295">IRhendium iyashesha ukuqalisa futhi izakhi ezisebenzisa iJavaScript kufanele zisebenze ngendlela eziklanywe ngayo</translation>
<translation id="6436260184216827876">Usesho Lomfanekiso alutholakali. Zama futhi kamuva.</translation>
<translation id="6442900851116057561">Qalisa kabusha i-RhendiumOS</translation>
<translation id="6443470774889161065">I-Rhendium ilayisha kusengaphambili amakhasi engeziwe ongase uwavakashele, ukuze alayishe ngokushesha kakhudlwana lapho uwavakashela</translation>
<translation id="6450948450282634257">Dawuniloda iRhendium efonini yakho ukuze ulandelele izintengo futhi uthole izexwayiso uma intengo yehla kunoma yiliphi isayithi</translation>
<translation id="645458117210240797">Kuvaliwe • I-Rhendium ayikwazi ukuqinisekisa ukuthi lesi sandiso sivela kuphi</translation>
<translation id="6455857529632101747">Siyakwamukela kumaphrofayela we-Rhendium</translation>
<translation id="6460614424172581323">Ngokuzayo uma uvula iRhendium ku-<ph name="DEVICE_TYPE" /> yakho, uzobona umyalelo wokusebenzisa amaqembu amathebhu.</translation>
<translation id="6466344609055215035">Susa I-akhawunti kuRhendium</translation>
<translation id="6475912303565314141">Iphinde ilawule ukuthi iliphi ikhasi eliboniswa lapho uqala i-Rhendium.</translation>
<translation id="648319183876919572">Ukubhrawuza Ngokuphepha Okugqamile kwenza okuningi ukukuvikela kumawebhusayithi ayingozi nakokudawunilodiwe</translation>
<translation id="6510925080656968729">Khipha i-Rhendium</translation>
<translation id="651535675648445253">Izinqamuleli zivulwe ku-Rhendium</translation>
<translation id="6539122709674868420">Inhlangano yakho ivala i-Rhendium uma ingasetshenziswa isikhathi esingu-<ph name="TIMEOUT_DURATION" />. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.</translation>
<translation id="6542839706527980775">Iphrofayela ngalinye linolwazi lwalo lwe-Rhendium njengamabhukhimakhi, umlando, amaphasiwedi, nokuningi</translation>
<translation id="6563921047760808519">Funda kabanzi mayelana <ph name="BEGIN_LINK" />nokuthi i-Rhendium igcina kanjani idatha yakho iyimfihlo<ph name="END_LINK" /></translation>
<translation id="6564039629497156115">Izinguquko kule sethingi zizosetshenziswa uma iRhendium iqala kabusha.</translation>
<translation id="6567032987737689854">Lawula izandiso zakho ngokuchofoza Izandiso kumenyu eyinhloko yeRhendium.</translation>
<translation id="656935081669708576">Ungashintsha ukuze ubone amaphasiwedi kusuka kwenye iphrofayela ye-Rhendium</translation>
<translation id="6569556444379005948">Sebenzisa i-app yeRhendium ukuze usebenzise amathuluzi e-AI ahamba phambili usendleleni</translation>
<translation id="6570579332384693436">Ukuze kulungiswe amaphutha okupeletwa, i-Rhendium ithumela umbhalo owuthayiphayo kuzinkambu zombhalo ku-Google</translation>
<translation id="6598877126913850652">Iya kuzilungiselelo zesaziso se-Rhendium</translation>
<translation id="6600016381025017075">Sesha noma yini kuleli khasi</translation>
<translation id="6613594504749178791">Izinguquko zakho zizosebenza ngesikhathi esilandelayo uma uqalisa kabusha i-Rhendium.</translation>
<translation id="6637908313088374648">IRhendium manje iqala ukusebenza lapho iWindows iqala ukuze uqale ukubhrawuza ngokushesha. Ungavala lokhu kumasethingi.</translation>
