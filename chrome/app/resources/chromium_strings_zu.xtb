<translation id="7045244423563602563">Yenza i-Rhendium Ibe Ngeyakho</translation>
<translation id="7047386856539490735">Ingabe ibe wusizo le miphumela?</translation>
<translation id="705851970750939768">Buyekeza i-Rhendium</translation>
<translation id="7067091210845072982">Uma isithombe singanayo incazelo ephelele, i-Rhendium izozama ukukunikezela eyodwa. Ukuze udale izincazelo, izithombe zithunyelwa ku-Google.</translation>
<translation id="7074836723476134809">Thola amandla e-AI uma usebenzisa i-app yeRhendium ku-<ph name="DEVICE_TYPE" /> yakho</translation>
<translation id="7134687062119989071">Thatha amaphasiwedi akho, amathebhu nokuningi usendleleni nge-app yeRhendium efonini yakho</translation>
<translation id="7141270731789036260">Yenza i-Chrome ibe ngokwezifiso ukuze ihlolwe</translation>
<translation id="7147227333672430807">Ungasebenzisa iRhendium noma nini lapho uchofoza amalinki emiyalezweni, amadokhumenti, namanye ama-app</translation>
<translation id="7163519456498498587">Susa <ph name="EXTENSION_NAME" /> kuRhendium</translation>
<translation id="7173822816570314652">Inhlangano yakho isula idatha ye-Rhendium uma ingasetshenziswa isikhathi esingu-<ph name="TIMEOUT_DURATION" />. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.</translation>
<translation id="718435575166326686">I-Rhendium idinga imvume yekhamera kule sayithi</translation>
<translation id="7196312274710523067">Ayikwazanga ukuqalisa i-Rhendium. Zama futhi.</translation>
<translation id="7204669035546236137">Buza noma yini, lapho ukhona, ngeGemini kuRhendium</translation>
<translation id="7213008767289637091">Gcina iRhendium Edokhini yakho ukuze ufike kuyo ngokushesha noma nini</translation>
<translation id="7213407614656404070">Sebenzisa i-Rhendium noma nini lapho uchofoza amalinki emiyalezweni, kumadokhumenti, nakwamanye ama-app</translation>
<translation id="7216228761061470870">Uma usebenzisa Usesho Lomfanekiso kudeskithophu, isihloko sekhasi, i-URL, nekhontenti, okuhlanganisa ama-PDF, kuthunyelwa kuseva</translation>
<translation id="7223968959479464213">Isiphathi somsebenzi - I-Rhendium</translation>
<translation id="7252276985725323153">Qala ukubhrawuza ngokushesha: IRhendium manje ingaqala lapho iWindows iqala.</translation>
<translation id="7274695763216404502">Kuphiniwe! Sebenzisa Usesho Lomfanekiso futhi kubha yamathuluzi</translation>
